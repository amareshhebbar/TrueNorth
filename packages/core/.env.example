# Database
DATABASE_URL=postgresql+asyncpg://truenorth:truenorth@localhost:5432/truenorth
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change_me_in_production_use_openssl_rand_hex_32
TRUENORTH_API_KEY=tn_your_dev_api_key_here

# LLM Providers (add the ones you use)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...

# Model routing
EXTRACTION_MODEL=gemini-2.0-flash-lite
CONVERSATION_MODEL=claude-3-5-haiku-20241022
OUTPUT_MODEL=claude-sonnet-4-20250514

# Limits (per session)
MAX_TOKENS_PER_SESSION=10000
MAX_COST_PER_SESSION_USD=0.05
MAX_SESSIONS_PER_USER_PER_DAY=10

# Encryption (for high/critical privacy fields — generate with: openssl rand -base64 32)
FIELD_ENCRYPTION_KEY=

# Environment
ENV=development
LOG_LEVEL=INFO
