# ── LLM API Keys ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AI...
OPENAI_API_KEY=sk-...        # optional — only if using OpenAI models

# ── LLM Routing Overrides (optional) ─────────────────────
# Override the default model for each task type
# TRUENORTH_MODEL_EXTRACT=gemini-3.5-flash
# TRUENORTH_MODEL_CONVERSE=claude-haiku-4-5-20251001
# TRUENORTH_MODEL_OUTPUT=claude-sonnet-4-20250514
# TRUENORTH_MODEL_CLASSIFY=gemini-3.5-flash

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://truenorth:truenorth@localhost:5432/truenorth

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── API Server ────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=your-secret-api-key-here   # used for X-TrueNorth-Key header auth
SECRET_KEY=change-me-in-production  # JWT signing key

# ── App Settings ──────────────────────────────────────────
ENVIRONMENT=development            # development | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
DEBUG=false

# ── Cost Limits ───────────────────────────────────────────
# TRUENORTH_DEFAULT_BUDGET_USD=0.50   # default per-session budget
# TRUENORTH_MAX_TURNS=50              # max turns per session

# ── Studio (Next.js dashboard) ───────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000